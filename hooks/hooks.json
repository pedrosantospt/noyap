{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/noyap-hook.sh\"",
            "commandWindows": "if (Get-Command sh -ErrorAction SilentlyContinue) { sh \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\noyap-hook.sh\" }",
            "timeout": 5,
            "statusMessage": "Loading NoYap..."
          }
        ]
      }
    ]
  }
}
